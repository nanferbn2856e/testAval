# Copia este archivo a .env y completa los valores reales.
# El .env NO se sube al repositorio. Aquí solo van valores ficticios.
#
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# ---------- Comunes a todos los ambientes ----------
SECRET_KEY=cambia-esta-clave
DATABASE_URL=postgres://usuario:clave@localhost:5432/nombre_db

# ---------- Solo producción (config.settings.prod) ----------
# Dominios o IPs desde los que se sirve la app, separados por comas
ALLOWED_HOSTS=midominio.com
# Origen(es) del frontend autorizados para llamar a la API
CORS_ALLOWED_ORIGINS=https://midominio.com
# Origen(es) de confianza para formularios y admin (incluye https://)
CSRF_TRUSTED_ORIGINS=https://midominio.com
# True en producción con HTTPS. False solo para simular prod en local con http://
SECURE_SSL_REDIRECT=True
